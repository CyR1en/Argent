	<!-- The version only until the first v* tag: scripts/build-app.sh writes the tag's version, the commit
	     count as CFBundleVersion, and ArgentVersion, ArgentChannel and ArgentCommit into the built app. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- MallocLargeCache 0: malloc keeps no freed large block in its large cache. A HEIC's encoder
	     (CMPhoto) grows each file in memory to 32 MB and frees it; the cache kept those blocks, dirty
	     and in the footprint, 1.1 to 1.3 GB by the fortieth frame, and 340-frame develops to HEIC
	     peaked at 2.28 to 2.59 GB in the app (docs/M2-shell.md section 10). The variable is
	     libmalloc's, undocumented; were macOS to ignore it, develops to HEIC would hold that cache
	     again, which the M5 memory check (scripts/measure/m5) shows. LaunchServices sets it at
	     launch; scripts/measure/m5/engine.zsh gives the test processes the same. -->
	<key>LSEnvironment</key>
	<dict>
		<key>MallocLargeCache</key>
		<string>0</string>
	</dict>
