<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- argent-remove, the helper that holds Remove's model (docs/remove-plan.md, section 4.5), started by the app
	     as its child: sandboxed, and inheriting the app's sandbox and container, so it reads the bundle's models
	     and serves its folder in the container and nothing else. A helper signed with inherit takes no other
	     entitlement. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
